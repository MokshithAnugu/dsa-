lass Solution(object):
    def minSubArrayLen(self, target, nums):
        n = len(nums)
        l = 0
        r = 0
        curr_sum = 0
        minlen = float('inf')

        while r < n:
            curr_sum += nums[r]

            while curr_sum >= target:
                minlen = min(minlen, r - l + 1)
                curr_sum -= nums[l]
                l += 1

            r += 1

        if minlen == float('inf'):
            return 0
        return minlen
