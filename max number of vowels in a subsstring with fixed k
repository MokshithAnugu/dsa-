class Solution(object):
    def maxVowels(self, s, k):
        n = len(s)

        l = 0
        r = 0
        count = 0
        maxi = 0

        while r < n:
            if s[r] in "aeiou":
                count += 1

            if r - l + 1 > k:
                if s[l] in "aeiou":
                    count -= 1
                l += 1

            if r - l + 1 == k:
                maxi = max(maxi, count)

            r += 1

        return maxi
