class Solution(object):
    def subarraySum(self, nums, k):
        
        prefix_sum = 0
        count = 0
        mp = {0: 1}

        for num in nums:
            prefix_sum += num

            remove = prefix_sum - k

            if remove in mp:
                count += mp[remove]

            mp[prefix_sum] = mp.get(prefix_sum, 0) + 1

        return count
