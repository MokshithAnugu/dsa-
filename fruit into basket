class Solution(object):
    def totalFruit(self, fruits):
        
        l = 0
        maxlen = 0
        count = {}

        for r in range(len(fruits)):
            count[fruits[r]] = count.get(fruits[r], 0) + 1

            while len(count) > 2:
                count[fruits[l]] -= 1

                if count[fruits[l]] == 0:
                    del count[fruits[l]]

                l += 1

            maxlen = max(maxlen, r - l + 1)

        return maxlen
