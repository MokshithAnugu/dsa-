class Solution(object):
    def findAnagrams(self, s, p):
        l = 0
        r = 0
        answer = []

        p_freq = {}

        for ch in p:
            p_freq[ch] = p_freq.get(ch, 0) + 1

        window = {}

        while r < len(s):

            # Add right character
            window[s[r]] = window.get(s[r], 0) + 1

            # Window reached size of p
            if r - l + 1 == len(p):

                # Check anagram
                if window == p_freq:
                    answer.append(l)

                # Remove left character
                window[s[l]] -= 1

                if window[s[l]] == 0:
                    del window[s[l]]

                l += 1

            r += 1

        return answer
