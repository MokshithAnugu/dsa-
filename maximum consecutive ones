class Solution(object):
    def longestOnes(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        
    
        l = 0
        zeros = 0
        maxlen = 0

        for r in range(len(nums)):

            if nums[r] == 0:
                zeros += 1

            while zeros > k:
                if nums[l] == 0:
                    zeros -= 1
                l += 1

            maxlen = max(maxlen, r - l + 1)

        return maxlen
