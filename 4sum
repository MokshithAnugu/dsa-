class Solution(object):
    def sortedSquares(self, nums):
      
        n = len(nums)

        # 1. Square every element
        for i in range(n):
            nums[i] = nums[i] * nums[i]

        # 2. Two pointers
        head = 0
        tail = n - 1

        # 3. Result array
        result = [0] * n

        # 4. Fill result from right to left
        for pos in range(n - 1, -1, -1):

            if nums[head] > nums[tail]:
                result[pos] = nums[head]
                head += 1
            else:
                result[pos] = nums[tail]
                tail -= 1

        return result
